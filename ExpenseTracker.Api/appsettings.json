{
  "ConnectionStrings": {
    "ExpenseTrackerDatabase": "your_db_connection_string_here"
  },
  "ClientSettings": {
    "BaseUrl": "your_frontend_url_here"
  },
  "AppSettings": {
    "Token": "your_jwt_secret_here",
    "Issuer": "BudgetWiseApi",
    "Audience": "BudgetWiseApp"
  },
  "SmtpSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUser": "your_email_here",
    "SmtpPassword": "your_app_password_here"
  },
  "Crypto": {
    "PrivateKey": "your_base64_private_key"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
