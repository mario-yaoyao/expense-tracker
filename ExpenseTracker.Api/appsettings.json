{
  "ConnectionStrings": {
    "ExpenseTrackerDatabase": "your_db_connection_string"
  },
  "AppSettings": {
    "Token": "your_jwt_secret_here",
    "Issuer": "ExpenseTrackerApi",
    "Audience": "ExpenseTrackerApp"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Trace", // Trace, Debug, Information, Warning, Error, Critical
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
